# Copier ce fichier en .env et renseigner ta clé

# Clé API Anthropic (utilisée pour la génération de réponse avec Claude)
# Les embeddings sont générés localement, aucune clé OpenAI n'est nécessaire.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL du serveur Chroma (par défaut en local)
CHROMA_URL=http://localhost:8000
